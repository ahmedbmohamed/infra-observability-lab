# {{ ansible_managed }}
# Site-specific rules, evaluated before the CRS. IDs 10000-19999 are reserved for local rules.

# Incident response: client IPs blocked by hand (edge_ip_denylist). One IP or CIDR per line in the file.
SecRule REMOTE_ADDR "@ipMatchFromFile /etc/nginx/modsec/ip-denylist.txt" \
    "id:10001,phase:1,deny,status:403,log,t:none,\
    msg:'Client IP on the deny list',\
    tag:'attack-denylist',tag:'local-rule'"

# Virtual patch: management endpoints of Java frameworks must never be reachable from the Internet,
# even if an application ships them by mistake.
SecRule REQUEST_FILENAME "@rx (?i)/(?:actuator|jolokia|console|manager/html)(?:/|$)" \
    "id:10010,phase:1,deny,status:403,log,t:none,t:urlDecodeUni,t:normalizePath,\
    msg:'Virtual patch: management endpoint blocked',\
    logdata:'%{REQUEST_FILENAME}',tag:'attack-virtual-patch',tag:'local-rule'"

# API contract: write requests to the API must be JSON. Anything else is refused before it reaches the origin.
# Two rules, because a negated match on a missing header never fires: 10020 = no Content-Type, 10021 = not JSON.
SecRule REQUEST_FILENAME "@beginsWith /api/" \
    "id:10020,phase:1,deny,status:415,log,t:none,\
    msg:'API write request without a Content-Type',\
    logdata:'%{REQUEST_METHOD} %{REQUEST_HEADERS.Content-Type}',tag:'attack-protocol',tag:'local-rule',\
    chain"
    SecRule REQUEST_METHOD "@within POST PUT PATCH" "t:none,chain"
        SecRule &REQUEST_HEADERS:Content-Type "@eq 0" "t:none"

SecRule REQUEST_FILENAME "@beginsWith /api/" \
    "id:10021,phase:1,deny,status:415,log,t:none,\
    msg:'API write request without a JSON body',\
    logdata:'%{REQUEST_METHOD} %{REQUEST_HEADERS.Content-Type}',tag:'attack-protocol',tag:'local-rule',\
    chain"
    SecRule REQUEST_METHOD "@within POST PUT PATCH" "t:none,chain"
        SecRule REQUEST_HEADERS:Content-Type "!@rx (?i)^application/json(?:\s*;.*)?$" "t:none"

# Virtual patch: XML external entities (XXE). The CRS has no rule for a document type that declares an
# external entity (found by GoTestWAF), and no API of this site needs one.
SecRule REQUEST_BODY|ARGS "@rx (?i)<!(?:DOCTYPE|ENTITY)[^>]*?\b(?:SYSTEM|PUBLIC)\b" \
    "id:10030,phase:2,deny,status:403,log,t:none,t:urlDecodeUni,\
    msg:'Virtual patch: XML external entity declaration',\
    logdata:'%{MATCHED_VAR_NAME}',tag:'attack-xxe',tag:'local-rule'"

# Same attack hidden with UTF-7 ("+ADwAIQ-DOCTYPE" is "<!DOCTYPE"). No client of this site sends UTF-7 XML.
SecRule REQUEST_BODY|ARGS "@rx (?i)<\?xml[^>]*encoding\s*=\s*[\"']?utf-7" \
    "id:10031,phase:2,deny,status:403,log,t:none,t:urlDecodeUni,\
    msg:'XML document encoded in UTF-7 (filter evasion)',\
    tag:'attack-xxe',tag:'local-rule'"

# Out-of-band testing services: attackers put these domains in headers or parameters to see if a server
# calls them back (blind SSRF, Log4Shell, blind XXE). A real customer request never contains them.
SecRule REQUEST_HEADERS|ARGS|REQUEST_BODY "@pm burpcollaborator.net oastify.com interact.sh oast.pro oast.live oast.site oast.online oast.fun oast.me dnslog.cn requestbin.net canarytokens.com" \
    "id:10040,phase:2,deny,status:403,log,t:none,t:lowercase,t:urlDecodeUni,\
    msg:'Out-of-band testing domain in the request',\
    logdata:'%{MATCHED_VAR_NAME}',tag:'attack-oast',tag:'local-rule'"
