# {{ ansible_managed }}

# Plain HTTP only redirects to HTTPS.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name {{ inventory_hostname }} localhost;

    ssl_certificate     {{ pki_remote_dir }}/{{ inventory_hostname }}.crt;
    ssl_certificate_key {{ pki_remote_dir }}/{{ inventory_hostname }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'" always;

{% if groups['edge'] | default([]) %}
    # Authenticated origin pull: the edge presents a client certificate signed by the lab CA.
    # Requests without it (someone bypassing the WAF) get 403. The check runs in each location below.
    ssl_client_certificate {{ pki_remote_dir }}/ca.crt;
    ssl_verify_client optional;
    ssl_verify_depth 2;

    # Log the real client IP sent by the edge, not the edge's own address.
{% for edge in groups['edge'] %}
    set_real_ip_from {{ hostvars[edge]['lab_ip'] }};
{% endfor %}
    real_ip_header X-Forwarded-For;
{% endif %}

    root {{ nginx_site_root }};
    index index.html;

    location / {
{% if groups['edge'] | default([]) %}
        if ($origin_pull_ok = 0) {
            return 403 "Direct access to the origin is not allowed.\n";
        }
{% endif %}
        # The edge may cache pages and static files for one minute.
        expires 60s;
        try_files $uri $uri/ =404;
    }

    # A tiny JSON API, enough to exercise the WAF, the cache rules and the rate limit.
    location /api/ {
{% if groups['edge'] | default([]) %}
        if ($origin_pull_ok = 0) {
            return 403 "Direct access to the origin is not allowed.\n";
        }
{% endif %}
        expires epoch;
        default_type application/json;
        return 200 '{"server":"{{ inventory_hostname }}","path":"$uri"}\n';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
