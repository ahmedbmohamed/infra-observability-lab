# Generated by Terraform from terraform/templates/prometheus.yml.tftpl. Do not edit inside the container.
global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]

  - job_name: node
    static_configs:
      - targets:
%{ for n in nodes ~}
          - "${n}:9100"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance

  - job_name: nginx
    static_configs:
      - targets:
%{ for n in nodes ~}
          - "${n}:9113"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance

  - job_name: edge
    static_configs:
      - targets: ["edge:9145"]
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance

  # blackbox_exporter runs on the edge and probes each URL; the URL becomes the "instance" label.
  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [https_lab]
    static_configs:
      - targets:
%{ for p in probes ~}
          - "${p}"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "edge:9115"
