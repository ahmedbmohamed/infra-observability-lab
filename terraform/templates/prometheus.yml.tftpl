# Generated by Terraform from terraform/templates/prometheus.yml.tftpl. Do not edit inside the container.
global:
  scrape_interval: 10s
  evaluation_interval: 10s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]

  - job_name: node
    static_configs:
      - targets:
%{ for n in nodes ~}
          - "${n}:9100"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance

  - job_name: nginx
    static_configs:
      - targets:
%{ for n in nodes ~}
          - "${n}:9113"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^:]+):.*"
        target_label: instance
