# Generated by Terraform (terraform/templates/hosts.yml.tftpl). Do not edit.
all:
  children:
    web:
      hosts:
%{ for name, node in nodes ~}
        ${name}:
          ansible_host: 127.0.0.1
          ansible_port: ${node.ssh_port}
          lab_ip: ${node.ip}
%{ endfor ~}
    edge:
      hosts:
        edge:
          ansible_host: 127.0.0.1
          ansible_port: ${edge.ssh_port}
          lab_ip: ${edge.ip}
  vars:
    ansible_user: ops
    ansible_ssh_private_key_file: ${private_key}
    # The containers are recreated often, so their host keys change.
    ansible_ssh_common_args: -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
